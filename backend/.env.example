# Переменные окружения для Backend

# Firebase Admin SDK
FIREBASE_ADMIN_KEY_PATH=./firebase-admin-key.json

# JWT Secret (уже используется в проекте)
JWT_SECRET=your_super_secret_key_here_change_in_production

# Порт сервера
PORT=3000

# ВАЖНО: Не коммитьте этот файл с реальными значениями!
# Создайте .env в корне backend/ и скопируйте эти переменные
